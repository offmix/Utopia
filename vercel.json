{
  "version": 2,
  "buildCommand": "npm install",
  "outputDirectory": "public",
  "env": {
    "NODE_ENV": "production"
  },
  "rewrites": [
    {
      "source": "/bare/:path*",
      "destination": "/api/bare.js?path=:path*"
    },
    {
      "source": "/service/:path*",
      "destination": "/api/proxy.js?path=:path*"
    },
    {
      "source": "/:path((?!api|_next).)*",
      "destination": "/:path"
    }
  ],
  "headers": [
    {
      "source": "/main/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
