{
  "version": 2,
  "builds": [
    {
      "src": "index.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "main/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/bare/(.*)",
      "dest": "index.mjs"
    },
    {
      "src": "/service/(.*)",
      "dest": "index.mjs"
    },
    {
      "src": "^/(?!bare|service)(.*)",
      "dest": "main/$1"
    }
  ]
}
